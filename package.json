{
  "name": "temp-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "ts-node --project tsconfig.seed.json scripts/seed.ts",
    "migrate:i18n-indexes": "ts-node --project tsconfig.seed.json scripts/migrate-i18n-indexes.ts",
    "seed:accounting": "ts-node --project tsconfig.seed.json scripts/seed-accounting.ts",
    "db:accounting:generate": "drizzle-kit generate",
    "db:accounting:migrate": "drizzle-kit migrate",
    "db:accounting:studio": "drizzle-kit studio",
    "db:accounting:create": "docker compose -f docker-compose.umami.yml exec -T umami-db psql -U umami -d umami -v ON_ERROR_STOP=1 -c \"CREATE ROLE cms_accounting LOGIN PASSWORD 'change-me-accounting'\" -c \"SELECT 'CREATE DATABASE cms_accounting OWNER cms_accounting' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'cms_accounting')\\gexec\"",
    "db:accounting:drop": "docker compose -f docker-compose.umami.yml exec -T umami-db psql -U umami -d umami -c \"DROP DATABASE IF EXISTS cms_accounting\" -c \"DROP ROLE IF EXISTS cms_accounting\""
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.33.0",
    "mongoose": "^9.9.3",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
